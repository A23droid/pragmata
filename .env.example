# ==============================================================================
# PRAGMATA Environment Configuration (Template)
# Copy this file to .env and adjust values as needed.
# NEVER commit .env to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pragmata
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pragmata

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# LLM Providers (Required in Phase 4)
# GEMINI_API_KEY=your_gemini_api_key_here
# GROQ_API_KEY=your_groq_api_key_here

# Switch Collaboration (Required in Phase 3)
# SWITCH_BASE_URL=https://your-switch-server.example.com
# SWITCH_REGISTRATION_TOKEN=your_switch_registration_token_here

# GitHub Integration (Required in Phase 5)
# GITHUB_TOKEN=your_github_token_here
